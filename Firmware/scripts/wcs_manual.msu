flash_img_check      128
flash_img_buffered_write 128
boot_request_upgrade  96
boot_is_img_confirmed 32
boot_read_bank_header 48
boot_fetch_active_slot 32
mcuboot_swap_type     32
z_impl_can_send       64
can_add_rx_filter     96
