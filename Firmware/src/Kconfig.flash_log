menu "Flash Log"

config FLASH_LOG
	bool "Flash-backed structured log"
	default n
	depends on FLASH_MAP
	select FCB
	select FCB_ALLOW_FIXED_ENDMARKER
	help
	  Persistent dive log captured to two parallel FCB instances on
	  external SPI NOR. Telemetry FCB holds structured records
	  (consensus, cell raw, PID, solenoid, errors, dive/boot
	  markers). Text FCB holds RTT capture of LOG_x messages plus
	  mirrored markers. Retrievable in bulk over UDS. See
	  docs/FLASH_LOG.md.

	  Enabled explicitly in the firmware prj.conf — left default-off
	  so unit tests without FLASH_MAP don't fail at the FCB select.

if FLASH_LOG

config FLASH_LOG_QUEUE_DEPTH
	int "log_writer ingest queue depth (slots)"
	default 8
	help
	  Number of pending entries the unified ingest queue can hold
	  before producers start dropping. Sized to absorb a single
	  64 KiB block erase (~150-400 ms on W25Q) at peak ingest of
	  ~400 B/s. STM32L431 has 64 KiB SRAM total; depth × slot-size
	  is the dominant RAM cost of this subsystem.

config FLASH_LOG_MAX_ENTRY_BYTES
	int "Max bytes per log entry (slot size in RAM)"
	default 96
	help
	  Cap on a single ingest slot. Each slot carries a 12-byte
	  internal header (dest, type, length, ts_us) and up to
	  (this - 12) bytes of payload. LOG_TEXT messages longer than
	  the payload budget are truncated.

config FLASH_LOG_WRITER_STACK
	int "log_writer thread stack size"
	default 1024
	help
	  Stack for fl_writer_thread (the only thread on the FCB write path).
	  The effective value is pinned in prj.conf; see the comment there for the
	  high-water history and the still-open fcb_rotate() worst-case measurement.

config FLASH_LOG_WRITER_PRIORITY
	int "log_writer thread priority"
	default 9
	help
	  Strictly below safety-critical threads (divecan_rx=5,
	  consensus=5, PID=6) and above the Zephyr log processing
	  thread (3). The writer can block on a flash erase without
	  delaying any control path.

config FLASH_LOG_CAPTURE_RTT
	bool "Capture LOG_x calls into the text FCB"
	default y
	depends on LOG

config FLASH_LOG_DEFAULT_RTT_LEVEL
	int "Default minimum log level captured to flash (1=ERR..4=DBG)"
	default 2
	range 1 4
	depends on FLASH_LOG_CAPTURE_RTT
	help
	  Runtime-overridable via UDS DID 0xF283 (LOG_VERBOSITY).
	  Default 2 = LOG_LEVEL_WRN.

config FLASH_LOG_CAN_VERBOSE_DEFAULT
	hex "Default LOG_CAN_VERBOSE bitmask"
	default 0x00
	range 0x00 0x03
	help
	  Bit 0 = capture CAN RX into telemetry FCB.
	  Bit 1 = capture CAN TX into telemetry FCB.
	  Default 0 — both off. Runtime-overridable via UDS DID 0xF284.
	  Default-off rationale: semantic protocol events become
	  structured telemetry entries already, and anything genuinely
	  unhandled produces a LOG_WRN that lands in the text FCB.

endif # FLASH_LOG

endmenu
