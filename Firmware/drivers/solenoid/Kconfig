config SOLENOID
	bool "Solenoid driver with hardware deadman timer"
	depends on GPIO && COUNTER
	default y
	help
	  Driver for GPIO-based solenoid outputs with a hardware
	  counter acting as a deadman timer. When the counter alarm
	  fires, all solenoid outputs are forced low from ISR context.

config SOLENOID_CURRENT_CHECK
	bool "Closed-loop solenoid current check"
	depends on SOLENOID
	default y
	help
	  Sample the generic whole-device current API (device_current.h) just
	  before energising a solenoid channel and again at the end of its
	  on-window, then classify the draw as normal / under / over current and
	  raise OP_ERROR on a debounced fault. The verdict is exposed via the
	  pollable status API for a higher layer to broadcast/log. Requires a
	  registered current provider (e.g. the Poseidon DS2782 fuel gauge, or a
	  board with an on-board solenoid/rail shunt); without one every channel
	  simply reports normal.

config SOLENOID_CURRENT_DELTA_MIN_UA
	int "Minimum expected solenoid fire-current delta (uA)"
	depends on SOLENOID_CURRENT_CHECK
	default 150000
	help
	  A fire whose (fire - idle) current delta falls below this reads as
	  UNDER-current (open coil / boost fault / stuck valve).
	  Default 150 mA is the measured lower bound of the Poseidon solenoid draw.

config SOLENOID_CURRENT_DELTA_MAX_UA
	int "Maximum expected solenoid fire-current delta (uA)"
	depends on SOLENOID_CURRENT_CHECK
	default 250000
	help
	  A fire whose (fire - idle) current delta rises above this reads as
	  OVER-current (possible short).
	  Default 250 mA is the measured upper bound of the Poseidon solenoid draw.

config SOLENOID_CURRENT_FAULT_STREAK
	int "Consecutive out-of-window fires before flagging a fault"
	depends on SOLENOID_CURRENT_CHECK
	default 3
	range 1 255
	help
	  Debounce: number of consecutive out-of-window fires on a channel
	  before its status latches to a fault. A nominal fire clears it.

config SOLENOID_INIT_PRIORITY
	int "Solenoid driver init priority"
	depends on SOLENOID
	default 90
	help
	  Must be after GPIO and counter drivers (typically 80).

config SOLENOID_LOG_LEVEL
	int "Solenoid driver log level"
	depends on SOLENOID
	default 3
	range 0 4
